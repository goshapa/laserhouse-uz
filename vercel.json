{
  "functions": {
    "api/bot.js": {
      "includeFiles": "assets/js/data.js",
      "maxDuration": 60
    },
    "api/ig.js": {
      "includeFiles": "assets/js/data.js",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "laserhouse.vercel.app" }],
      "destination": "https://laserhouse.uz/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
